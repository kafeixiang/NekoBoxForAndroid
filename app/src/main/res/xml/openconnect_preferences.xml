<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="name"
        app:title="@string/profile_name"
        app:useSimpleSummaryProvider="true" />

    <PreferenceCategory
        app:key="category_openconnect_auth"
        app:title="@string/openconnect_authentication">
        <Preference
            app:icon="@drawable/ic_action_delete"
            app:key="clearFormEntries"
            app:title="@string/clear_remembered_authentication_answers" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/proxy_cat">
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="server"
            app:title="@string/openconnect_server"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/openconnect_flavor_entry"
            app:entryValues="@array/openconnect_flavor_value"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="flavor"
            app:title="@string/openconnect_flavor"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_person_24"
            app:key="username"
            app:title="@string/username"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="password"
            app:title="@string/password" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_person_24"
            app:key="authGroup"
            app:title="@string/openconnect_auth_group"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue=""
            app:entries="@array/openconnect_reported_os_entry"
            app:entryValues="@array/openconnect_reported_os_value"
            app:icon="@drawable/ic_hardware_router"
            app:key="reportedOS"
            app:title="@string/openconnect_reported_os"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="userAgent"
            app:title="@string/openconnect_user_agent"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="localHostname"
            app:title="@string/openconnect_local_hostname"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="allowInsecureCrypto"
            app:title="@string/openconnect_allow_insecure_crypto" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/security_settings">
        <SwitchPreference
            app:icon="@drawable/ic_notification_enhanced_encryption"
            app:key="tlsInsecure"
            app:title="@string/allow_insecure" />
        <EditTextPreference
            app:icon="@drawable/ic_action_copyright"
            app:key="tlsServerName"
            app:title="@string/sni"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_fingerprint_24"
            app:key="tlsPeerFingerprint"
            app:title="@string/openconnect_tls_peer_fingerprint"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="certificateAuthority"
            app:title="@string/openconnect_ca"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="clientCertificate"
            app:title="@string/openvpn_client_certificate"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="clientKey"
            app:title="@string/openvpn_client_key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="clientKeyPassword"
            app:title="@string/openconnect_client_key_password" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="mcaCertificate"
            app:title="@string/openconnect_mca_certificate"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_vpn_key_24"
            app:key="mcaKey"
            app:title="@string/openconnect_mca_key"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogLayout="@layout/layout_password_dialog"
            app:icon="@drawable/ic_settings_password"
            app:key="mcaKeyPassword"
            app:title="@string/openconnect_mca_key_password" />
    </PreferenceCategory>

</PreferenceScreen>
