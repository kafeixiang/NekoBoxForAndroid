<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <EditTextPreference
        app:icon="@drawable/ic_social_emoji_symbols"
        app:key="routeName"
        app:title="@string/route_name"
        app:useSimpleSummaryProvider="true" />
    <moe.matsuri.nb4a.ui.EditConfigPreference
        app:icon="@drawable/ic_baseline_layers_24"
        app:key="serverConfig"
        app:title="@string/custom_config"
        app:useSimpleSummaryProvider="true" />
    <PreferenceCategory app:title="@string/cag_route">
        <io.nekohasekai.sagernet.widget.AppListPreference
            app:icon="@drawable/ic_baseline_legend_toggle_24"
            app:key="routePackages"
            app:title="@string/apps" />
        <EditTextPreference
            app:dialogMessage="geosite:category-ads-all, geoip:cn"
            app:icon="@drawable/ic_baseline_rule_folder_24"
            app:key="routeRuleSet"
            app:title="@string/route_ruleset"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_domain_24"
            app:key="routeDomain"
            app:title="domain"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_add_road_24"
            app:key="routeIP"
            app:title="dst ip"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:icon="@drawable/ic_maps_directions_boat"
            app:key="routePort"
            app:title="dst port"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_local_bar_24"
            app:key="routeSource"
            app:title="src ip"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_baseline_home_24"
            app:key="routeSourcePort"
            app:title="src port"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/route_protocol_entry"
            app:entryValues="@array/route_protocol_value"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="routeNetwork"
            app:title="network"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogMessage="tls, http, quic, dns, stun, bittorrent, dtls, ssh, rdp, ntp"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="routeProtocol"
            app:title="protocol"
            app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:defaultValue="0"
            app:entries="@array/ip_version_entries"
            app:entryValues="@array/ip_version_values"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="routeIpVersion"
            app:title="@string/route_ip_version"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:dialogMessage="chromium, safari, firefox, quic-go"
            app:icon="@drawable/ic_baseline_layers_24"
            app:key="routeClient"
            app:summary="@string/route_client_summary"
            app:title="@string/route_client"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="routeIpIsPrivate"
            app:title="@string/route_ip_is_private" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_security_24"
            app:key="routeSourceIpIsPrivate"
            app:title="@string/route_source_ip_is_private" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/network_type_entries"
            app:entryValues="@array/network_type_values"
            app:icon="@drawable/ic_baseline_compare_arrows_24"
            app:key="routeNetworkType"
            app:title="@string/route_network_type"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_device_data_usage"
            app:key="routeNetworkIsExpensive"
            app:summary="@string/route_network_is_expensive_summary"
            app:title="@string/route_network_is_expensive" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_speed_24"
            app:key="routeNetworkIsConstrained"
            app:summary="@string/route_network_is_constrained_summary"
            app:title="@string/route_network_is_constrained" />
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="routeWifiSSID"
            app:title="@string/route_wifi_ssid"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="routeWifiBSSID"
            app:title="@string/route_wifi_bssid"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_rule_folder_24"
            app:key="routeRuleSetMatchSource"
            app:summary="@string/route_ruleset_match_source_summary"
            app:title="@string/route_ruleset_match_source" />
        <SwitchPreference
            app:icon="@drawable/ic_baseline_flip_camera_android_24"
            app:key="routeInvert"
            app:summary="@string/route_invert_summary"
            app:title="@string/route_invert" />
        <moe.matsuri.nb4a.ui.SimpleMenuPreference
            app:entries="@array/reject_method_entries"
            app:entryValues="@array/reject_method_values"
            app:icon="@drawable/ic_baseline_warning_24"
            app:key="routeRejectMethod"
            app:summary="@string/route_reject_method_summary"
            app:title="@string/route_reject_method"
            app:useSimpleSummaryProvider="true" />
        <io.nekohasekai.sagernet.widget.OutboundPreference
            app:icon="@drawable/ic_hardware_router"
            app:key="routeOutbound"
            app:title="outbound"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
